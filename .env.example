# --- Model access -----------------------------------------------------------
# Pydantic AI Gateway key (starts with pylf_v...). Create it in your Logfire
# organization's Gateway settings, and BYOK your Anthropic key there (free, no markup).
PYDANTIC_AI_GATEWAY_API_KEY=

# Direct Anthropic key. Needed for --routing direct|split, and as fallback.
ANTHROPIC_API_KEY=

# --- Observability ----------------------------------------------------------
# Logfire write token (Logfire project settings). Free tier: 10M spans/month.
# Without it the app still runs; traces just aren't sent.
LOGFIRE_TOKEN=

# --- deepresearch settings (all optional, DEEPRESEARCH_ prefix) -------------
# DEEPRESEARCH_PROFILE=standard          # quick | standard | deep
# DEEPRESEARCH_ROUTING=gateway           # gateway | direct | split
# DEEPRESEARCH_MAX_COST=2.0              # USD cap for a run (overrides profile default)
# DEEPRESEARCH_VERIFY=true
# DEEPRESEARCH_MAX_REVISE_ITERS=2        # critic-driven revise passes; 0 disables the loop (cheapest)
# DEEPRESEARCH_TRANSPORT_RETRIES=true    # tenacity transport: 429/5xx retries with Retry-After
# Per-role model overrides (bare model names, no provider prefix):
# DEEPRESEARCH_MODELS__PLANNER=claude-opus-4-8
# DEEPRESEARCH_MODELS__RESEARCHER=claude-haiku-4-5
